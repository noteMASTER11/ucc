diff --git a/src/mtp_runtime_profile.h b/src/mtp_runtime_profile.h
new file mode 100644
index 0000000..8286b87
--- /dev/null
+++ b/src/mtp_runtime_profile.h
@@ -0,0 +1,25 @@
+/* Generated from a sealed MTP hardware classification. */
+#ifndef MTP_RUNTIME_PROFILE_H
+#define MTP_RUNTIME_PROFILE_H
+
+#include <linux/dmi.h>
+
+static inline bool mtp_runtime_profile_matches(void)
+{
+	static const struct dmi_system_id systems[] = {
+		{
+			.ident = "MTP:runtime-mechrevo-yaoshi-x6ar55xy-intel",
+			.matches = {
+				DMI_EXACT_MATCH(DMI_SYS_VENDOR, "MECHREVO"),
+				DMI_EXACT_MATCH(DMI_BOARD_NAME, "YAOSHI Series-X6AR55xY"),
+				DMI_EXACT_MATCH(DMI_BOARD_VERSION, "Standard"),
+				DMI_EXACT_MATCH(DMI_PRODUCT_SKU, "0001"),
+			},
+		},
+		{ }
+	};
+
+	return dmi_check_system(systems);
+}
+
+#endif
