[Desktop Entry]
Type=Application
Name=Uniwill Control Center
Comment=System control application for Uniwill laptops
Exec=ucc-gui
Icon=ucc-gui
Terminal=false
Categories=System;Settings;Qt;
# A singleton launch may only activate an existing process, without completing
# the desktop's startup-notification transaction.
StartupNotify=false
# Ensure KDE associates running windows with this desktop file
StartupWMClass=ucc-gui
